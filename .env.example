# Database connection string (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/vestiq_db?schema=public"

# Secret key for JWT sessions (min 32 characters)
JWT_SECRET="replace-with-a-random-32-byte-hex-string-for-production"

# Application settings
NEXT_PUBLIC_APP_NAME="Vestiq"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
